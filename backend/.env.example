# =============================================================
# Technova backend — environment variable template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================

# --- Django core ---
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database: TiDB Cloud (MySQL-compatible) ---
# Obtain these from your TiDB Cloud Starter cluster → Connect panel.
DB_NAME=technova
DB_USER=replace-with-tidb-username
DB_PASSWORD=replace-with-tidb-password
DB_HOST=replace-with-tidb-gateway-host.tidbcloud.com
DB_PORT=4000

# --- Database SSL/TLS (required for TiDB Cloud) ---
# Absolute path to the downloaded ISRG Root X1 CA certificate.
# Download: https://letsencrypt.org/certs/isrgrootx1.pem
# Example (Windows local dev): C:\Users\you\Downloads\isrgrootx1.pem
# Example (Linux / Render):    /etc/ssl/certs/isrgrootx1.pem
# Leave blank to fall back to certifi bundle validation.
DB_SSL_CA=replace-with-absolute-path-to-isrgrootx1.pem

# DB_SSL_VERIFY_CERT=true    # Set to 'false' ONLY for local testing (not production)

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# --- AI: Google Gemini ---
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# --- Payments: Razorpay ---
# Keep secrets in backend/.env only; never use a live key until deployment review.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Order settings ---
ORDER_CURRENCY=INR
ORDER_DELIVERY_CHARGE=0.00
