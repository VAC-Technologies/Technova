
# Environment secrets
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Python generated files
__pycache__/
*.py[cod]
.pytest_cache/

# Virtual environments
.venv/
venv/

# Local databases and backups
*.sqlite3
*.sqlite3-*
*.db
*.bak

# Frontend dependencies and builds
node_modules/
dist/
coverage/

# Local uploads - review and back up separately
backend/media/
backend/staticfiles/

# TiDB / SSL CA certificates (store locally; never commit private certs)
# The public ISRG Root X1 cert is safe to commit but excluded here to
# avoid confusion; use the path in DB_SSL_CA env var instead.
backend/certs/*.pem

# Logs
*.log

# Local development settings
backend/config/settings_local.py
